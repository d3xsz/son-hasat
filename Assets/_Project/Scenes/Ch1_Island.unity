--- !u!1001 &1281022367
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 6901871169143182730, guid: 6c45981b10ad59149aa99fa8d9d2d220, type: 3}
      propertyPath: body
      value: "\u2026kim okursa.\n\nSis geldi\u011Finde gemi yoktu art\u0131k. Sonra
        biz de yoktuk, birer birer.\n\nOrmanda ta\u015F y\xFCzler var. Bize bak\u0131yorlar.
        Yanlar\u0131nda nefes almak kolayla\u015F\u0131yor; nedenini kimse bilmiyor.
        Ya da bilen kalmad\u0131.\n\nPar\u0131ldayan \u015Feylere dokunma. Ne kadar
        g\xFCzel g\xF6r\xFCnseler de.\n\nOnlar\u0131 yerinden kald\u0131rd\u0131\u011F\u0131m\u0131z
        gece ada inledi. A\u011Fa\xE7lar\u2026 dinliyor sanki. Toprak bir \u015Feyi
        hat\u0131rl\u0131yor.\n\nBe\u015F. Hep be\u015F.\n\nA\u015Fa\u011F\u0131da
        bir \u015Fey bekliyor."
      objectReference: {fileID: 0}
