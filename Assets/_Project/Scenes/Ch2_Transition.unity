--- !u!1001 &923726231
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 6901871169143182730, guid: 6c45981b10ad59149aa99fa8d9d2d220, type: 3}
      propertyPath: body
      value: "Burada karanl\u0131k kendi ba\u015F\u0131na ya\u015F\u0131yor.\n\nTa\u015Flar
        \u0131\u015F\u0131\u011F\u0131 hat\u0131rl\u0131yor. Onlara uzun bakarsan
        sana geri bakarlar.\n\nCebimdeki k\u0131r\u0131k par\xE7alar h\xE2l\xE2 \u0131l\u0131k.
        B\u0131rakamad\u0131m. Bir yere ait olduklar\u0131n\u0131 hissediyorum\u2026
        ama nereye?\n\nO \u015Feyin g\xF6zleri yok. Yine de ad\u0131mlar\u0131m\u0131
        biliyor. Nefesimi bile.\n\nK\xF6pr\xFC uzun zamand\u0131r kimseyi ta\u015F\u0131mad\u0131.\n\nDuvarlar\u0131n
        s\u0131rr\u0131 \u0131\u015F\u0131kta. Birden ba\u015Fla.\n\nBen burada kal\u0131yorum."
      objectReference: {fileID: 0}
    - target: {fileID: 6901871169143182730, guid: 6c45981b10ad59149aa99fa8d9d2d220, type: 3}
