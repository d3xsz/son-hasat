--- !u!1001 &465822600
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 2105329296}
    m_Modifications:
    - target: {fileID: 6901871169143182730, guid: 6c45981b10ad59149aa99fa8d9d2d220, type: 3}
      propertyPath: body
      value: "Buraya d\xFC\u015Fen ilk sen de\u011Filsin.\n\nBu k\xF6yde hi\xE7bir
        \u015Fey oldu\u011Fu boyda kalmaz. Fenerin de burada ba\u015Fka t\xFCrl\xFC
        yanar: bir \u0131\u015F\u0131\u011F\u0131 b\xFCy\xFCt\xFCr, \xF6teki k\xFC\xE7\xFClt\xFCr.
        Soluk soluk parlayan \u015Feylere tut, g\xF6receksin.\n\nUyku bast\u0131r\u0131rsa
        meydandaki fener mantar\u0131n\u0131n dibine gel; \u0131\u015F\u0131\u011F\u0131
        insan\u0131 ay\u0131k tutar. Karanl\u0131k pencerelere yakla\u015Fma. Bakarlarsa
        \u0131\u015F\u0131\u011F\u0131n\u0131 \xFCstlerine tut.\n\nKap\u0131s\u0131nda
        fener yanan evlerde yataklar var. Kilitlerini a\xE7.\nHerkes yatmadan kimse
        uyanamaz."
      objectReference: {fileID: 0}
    - target: {fileID: 6901871169143182730, guid: 6c45981b10ad59149aa99fa8d9d2d220, type: 3}
      propertyPath: title
      value: 
